# คัดลอกเป็น .env แล้วใส่ค่าจาก Firebase Console → Project settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ที่นั่ง live จาก Bluehouse (optional — default ใน siteContent.seatingLiveJsonUrl)
VITE_SEATING_JSON_URL=

# Media API — หลัง npm run media:deploy ใส่ URL ที่ script แสดง
# https://asia-southeast1-PROJECT.cloudfunctions.net/mediaApi
VITE_MEDIA_API_BASE=

# (optional) album สำหรับ npm run media:verify
# MEDIA_VERIFY_ALBUM=prewedding
