# คัดลอกเป็น functions/.env (อย่า commit)
# แนะนำ: เก็บ JSON เป็นไฟล์แล้วอ้าง path — ง่ายกว่าวาง JSON ยาวใน .env

# โปรเจกต์ Firebase (ต้อง Blaze ถึง deploy Functions)
FIREBASE_PROJECT_ID=

# วิธี A — path ไปไฟล์ (แนะนำ)
GOOGLE_SERVICE_ACCOUNT_JSON_FILE=../secrets/google-service-account.json
DRIVE_ALBUMS_JSON_FILE=../secrets/drive-albums.json

# วิธี B — JSON บรรทัดเดียว (ถ้าไม่ใช้ FILE)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# DRIVE_ALBUMS_JSON={"prewedding":"FOLDER_ID",...}

# CORS สำหรับเว็บแขก (optional — มี default)
ALLOWED_ORIGINS=https://icemintwedding20dec26.com,https://www.icemintwedding20dec26.com,http://127.0.0.1:5173,http://localhost:5173
