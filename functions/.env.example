# คัดลอกเป็น .env สำหรับ emulator / deploy จากเครื่อง (อย่า commit)

# JSON ของ Service Account ทั้งก้อน (escape หรือใส่ไฟล์แล้วอ่านตอน deploy ผ่าน Firebase secrets)
GOOGLE_SERVICE_ACCOUNT_JSON=

# แมป albumKey → Drive folder ID (ดู drive-albums.example.json)
DRIVE_ALBUMS_JSON=

# คั่นด้วย comma
ALLOWED_ORIGINS=https://icemintwedding20dec26.com,http://127.0.0.1:5173,http://localhost:5173

# โฮสที่ Functions ใช้สร้าง URL ใน response (optional — infer จาก request)
MEDIA_PUBLIC_BASE=
